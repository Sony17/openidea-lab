# Copy to .env.local. Every key is optional in development: a missing provider makes its
# flow show "not configured" instead of crashing. Never commit .env.local.

# Public URL of this deployment. Used for hand-off links back to the platform.
NEXT_PUBLIC_LAB_URL=https://lab.openidea.world

# --- Open Idea platform (pre-existing; not part of the hackathon submission) ---
# Public API key from https://openidea.world/developer
OPENIDEA_API_URL=https://openidea.world/api/v1
OPENIDEA_API_KEY=

# --- Meta Model API: Muse Spark ---
META_API_KEY=
META_MODEL=muse-spark          # check https://ai.meta.com for the current model id

# --- Fireworks: fast fix loop, ranking, structured extraction ---
FIREWORKS_API_KEY=
FIREWORKS_CODE_MODEL=accounts/fireworks/models/qwen3-coder-480b-a35b-instruct
FIREWORKS_VISION_MODEL=accounts/fireworks/models/llama4-maverick-instruct-basic

# --- Baseten: SAM 3 deployment ---
BASETEN_API_KEY=
BASETEN_SAM3_MODEL_ID=         # from the Baseten dashboard after `truss push baseten/sam3`
